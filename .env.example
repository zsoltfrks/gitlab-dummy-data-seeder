# Where the GitLab instance is and how the seeder signs in. Copy this file to .env and fill it in.
# .env holds a secret and is git-ignored; keep it that way.
# Variables already set in your shell take precedence over .env.

# Base URL of the instance, without /api/v4.
GITLAB_URL=http://localhost:8080

# Access token. Scopes: `api` is required and `sudo` is recommended.
# Creating users needs an administrator's token.
GITLAB_TOKEN=
